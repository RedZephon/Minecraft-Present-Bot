# MC Presence — Environment Configuration
# Copy this file to .env and fill in your values.

# Minecraft server to connect bots to (also editable in Settings)
MC_HOST=play.example.net
MC_PORT=25565

# Web dashboard
WEB_PORT=3100
# Interface to listen on. Use 127.0.0.1 to keep the dashboard local-only.
WEB_HOST=0.0.0.0
# Strongly recommended. Without it, anyone who can reach WEB_PORT can chat and
# run commands as your Minecraft accounts.
DASHBOARD_PASSWORD=
# Only needed behind a reverse proxy that rewrites the Host header:
# comma-separated origins allowed to use the dashboard, e.g. https://mc.example.com
ALLOWED_ORIGINS=
# Set when behind a reverse proxy so client IPs/HTTPS are detected (e.g. 1)
TRUST_PROXY=

# Anthropic API key (required for AI chat modes; also settable in the dashboard)
ANTHROPIC_API_KEY=

# CobbleBridge plugin connection (optional). Use a long random secret and set
# the same value in the plugin config.
BRIDGE_URL=http://localhost:3101
BRIDGE_SECRET=

# Discord webhook for messages from virtual (bridge) sessions (optional)
DISCORD_WEBHOOK=

# Your Minecraft username. Only this account can use the AFK Responder, and
# it can silence/resume the support bot from in-game chat.
OWNER_USERNAME=
# Other staff, comma-separated. Their chat is treated as authoritative when
# the support bot learns from chat, and they're left out of "when are players
# usually on" predictions.
STAFF_USERNAMES=
# IANA timezone for the maintenance window, activity predictions and times the
# AI quotes (e.g. America/Edmonton). Also settable in the dashboard.
SERVER_TIMEZONE=

# Advanced
# DATA_DIR=./data                 # sessions, settings, known players
# AUTH_DIR=./.minecraft           # Microsoft token cache
# MC_CONNECT_TIMEOUT_MS=90000     # give up on a login that never completes
# MC_SPAWN_TIMEOUT_MS=45000       # give up on a login that never spawns
# MC_PACKET_TRACE=1               # log every play-state packet name
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # e.g. an API gateway
